\@writefile{toc}{\contentsline {chapter}{\numberline {6}The Conductor Takes the Stage}{17}{chapter.6}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.0.1}1. The Genius of the Control Loop}{17}{subsection.6.0.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces The Kubernetes control loop. Controllers continuously observe the current state, compare it to the desired state, and take action to reconcile any difference --- then repeat forever.}}{17}{figure.6.1}\protected@file@percent }
\newlabel{fig:5_1}{{6.1}{17}{The Kubernetes control loop. Controllers continuously observe the current state, compare it to the desired state, and take action to reconcile any difference --- then repeat forever}{figure.6.1}{}}
\@writefile{toc}{\contentsline {subsubsection}{\textbf  {The Old Way: Edge-Triggered (Imperative)}}{17}{figure.6.1}\protected@file@percent }
\BKM@entry{id=21,dest={73756273656374696F6E2E362E302E32},srcline={85}}{}
\@writefile{toc}{\contentsline {subsubsection}{\textbf  {The Kubernetes Way: Level-Triggered (Declarative)}}{18}{figure.6.1}\protected@file@percent }
\newlabel{fig:5_2}{{6.0.1}{18}{\textbf {The Kubernetes Way: Level-Triggered (Declarative)}}{figure.6.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces Reconciliation loop iterations. The controller continuously drives the observed state toward the desired state --- creating Pods when there are too few, terminating when there are too many.}}{19}{figure.6.2}\protected@file@percent }
\newlabel{fig:5_3}{{6.2}{19}{Reconciliation loop iterations. The controller continuously drives the observed state toward the desired state --- creating Pods when there are too few, terminating when there are too many}{figure.6.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.0.2}2. Etcd: The Cluster's Single Source of Truth}{19}{subsection.6.0.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\textbf  {The CAP Theorem and Why Consistency Matters}}{19}{subsection.6.0.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces The CAP Theorem triangle. In a distributed system, you can only guarantee two of three properties. Kubernetes and etcd choose \textbf  {Consistency + Partition Tolerance (CP)} --- they would rather become briefly unavailable than serve stale or conflicting data.}}{20}{figure.6.3}\protected@file@percent }
\newlabel{fig:5_4}{{6.3}{20}{The CAP Theorem triangle. In a distributed system, you can only guarantee two of three properties. Kubernetes and etcd choose \textbf {Consistency + Partition Tolerance (CP)} --- they would rather become briefly unavailable than serve stale or conflicting data}{figure.6.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces Raft consensus in etcd. A write is only confirmed after the leader replicates it to a majority (quorum) of followers, ensuring no data is lost even if a node fails.}}{20}{figure.6.4}\protected@file@percent }
\newlabel{fig:5_5}{{6.4}{20}{Raft consensus in etcd. A write is only confirmed after the leader replicates it to a majority (quorum) of followers, ensuring no data is lost even if a node fails}{figure.6.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.5}{\ignorespaces The etcd watch and controller flow. When a user submits a desired state, it is stored in etcd. The watch mechanism notifies the relevant controller, which compares, acts, and updates state --- completing the reconciliation loop.}}{21}{figure.6.5}\protected@file@percent }
\newlabel{fig:5_6}{{6.5}{21}{The etcd watch and controller flow. When a user submits a desired state, it is stored in etcd. The watch mechanism notifies the relevant controller, which compares, acts, and updates state --- completing the reconciliation loop}{figure.6.5}{}}
