\BKM@entry{id=29,dest={73756273656374696F6E2E372E302E37},srcline={190}}{5C3337365C3337375C303030545C303030685C303030655C3030305C3034305C303030465C303030755C3030306C5C3030306C5C3030305C3034305C303030505C303030695C303030635C303030745C303030755C303030725C30303065}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces The admission webhook pipeline. Every API request passes through authentication, mutating webhooks (which can modify the request), schema validation, and validating webhooks (which can reject it) before being persisted to etcd.}}{27}{figure.7.3}\protected@file@percent }
\newlabel{fig:6_3}{{7.3}{27}{The admission webhook pipeline. Every API request passes through authentication, mutating webhooks (which can modify the request), schema validation, and validating webhooks (which can reject it) before being persisted to etcd}{figure.7.3}{}}
