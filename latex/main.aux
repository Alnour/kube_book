\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Operator reconciliation loop for a MySQL cluster. The operator follows domain-specific steps (primary first, then replicas, then backups). On a crash, it performs intelligent recovery --- resyncing data rather than blindly restarting.}}{25}{figure.7.2}\protected@file@percent }
\newlabel{fig:6_2}{{7.2}{25}{Operator reconciliation loop for a MySQL cluster. The operator follows domain-specific steps (primary first, then replicas, then backups). On a crash, it performs intelligent recovery --- resyncing data rather than blindly restarting}{figure.7.2}{}}
