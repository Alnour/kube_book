\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.0.1}1. "Failure is Not an Anomaly; It is the Nominal State"}{14}{subsection.5.0.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Jeff Dean's failure statistics for a typical Google cluster. Hardware failure is not an exception --- it is the constant, nominal state at scale. (Note: a single power failure can affect 500–1,000 machines simultaneously.)}}{14}{figure.5.1}\protected@file@percent }
\newlabel{fig:4_1}{{5.1}{14}{Jeff Dean's failure statistics for a typical Google cluster. Hardware failure is not an exception --- it is the constant, nominal state at scale. (Note: a single power failure can affect 500–1,000 machines simultaneously.)}{figure.5.1}{}}
