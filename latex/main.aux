\@writefile{toc}{\contentsline {chapter}{\numberline {4}The Virtual Machine Takes Over}{11}{chapter.4}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.0.1}1. The Problem of the Empty Server}{11}{subsection.4.0.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces The server utilization problem. Most data center servers in the early 2000s used only 10–15\% of their capacity, leaving the vast majority of expensive hardware idle.}}{11}{figure.4.1}\protected@file@percent }
\newlabel{fig:3_1}{{4.1}{11}{The server utilization problem. Most data center servers in the early 2000s used only 10–15\% of their capacity, leaving the vast majority of expensive hardware idle}{figure.4.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.0.2}2. Xen and the Art of Cooperation (Paravirtualization)}{11}{subsection.4.0.2}\protected@file@percent }
\BKM@entry{id=14,dest={73756273656374696F6E2E342E302E33},srcline={47}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Full virtualization vs. paravirtualization. Full virtualization must trap and translate every privileged instruction (slow). Xen's paravirtualization uses direct hypercalls from a modified guest OS, achieving near-native speed.}}{12}{figure.4.2}\protected@file@percent }
\newlabel{fig:3_2}{{4.2}{12}{Full virtualization vs. paravirtualization. Full virtualization must trap and translate every privileged instruction (slow). Xen's paravirtualization uses direct hypercalls from a modified guest OS, achieving near-native speed}{figure.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.0.3}3. KVM and the Genius of Integration (Hardware Virtualization)}{12}{subsection.4.0.3}\protected@file@percent }
\BKM@entry{id=15,dest={73756273656374696F6E2E342E302E34},srcline={71}}{}
\newlabel{fig:3_3}{{4.0.3}{13}{3. KVM and the Genius of Integration (Hardware Virtualization)}{subsection.4.0.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.0.4}4. Why This Matters for Kubernetes}{13}{subsection.4.0.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Key milestones from virtualization to Kubernetes. Each breakthrough built on the previous, culminating in a unified platform that manages both containers and VMs.}}{13}{figure.4.3}\protected@file@percent }
\newlabel{fig:3_4}{{4.3}{13}{Key milestones from virtualization to Kubernetes. Each breakthrough built on the previous, culminating in a unified platform that manages both containers and VMs}{figure.4.3}{}}
