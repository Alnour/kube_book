\@writefile{toc}{\contentsline {subsection}{\numberline {7.0.2}2. Custom Resource Definitions (CRDs): Teaching Kubernetes New Words}{23}{subsection.7.0.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.0.3}3. The Operator Pattern: Encoding Human Knowledge Into Software}{23}{subsection.7.0.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces CRD registration flow. An admin first registers the CRD schema, teaching the API Server a new resource type. Then custom resources of that type can be created, validated, and stored --- just like built-in resources.}}{24}{figure.7.1}\protected@file@percent }
\newlabel{fig:6_1}{{7.1}{24}{CRD registration flow. An admin first registers the CRD schema, teaching the API Server a new resource type. Then custom resources of that type can be created, validated, and stored --- just like built-in resources}{figure.7.1}{}}
