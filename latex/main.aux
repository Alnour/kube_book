\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces The full Kubernetes extensibility stack. Each layer builds on the one below --- CRDs extend vocabulary, Operators extend behavior, Admission Webhooks extend enforcement, and Helm packages everything for distribution.}}{28}{figure.7.4}\protected@file@percent }
\newlabel{fig:6_4}{{7.4}{28}{The full Kubernetes extensibility stack. Each layer builds on the one below --- CRDs extend vocabulary, Operators extend behavior, Admission Webhooks extend enforcement, and Helm packages everything for distribution}{figure.7.4}{}}
